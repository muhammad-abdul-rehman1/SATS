# JWT signing secrets — use long, random strings in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# Allowed CORS origin for the web dashboard.
# Not required for the mobile app (React Native does not enforce CORS).
# CORS_ORIGIN=http://localhost:3000
