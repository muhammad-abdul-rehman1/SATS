# ─── SATS Frontend — Environment Template ─────────────────────────────────────
# Copy this file to .env and fill in your values.
# Do NOT commit .env — it contains machine-specific settings.
#
# EXPO_PUBLIC_* variables are inlined at bundle time by Metro.
# Changes require restarting the Expo dev server (npx expo start --clear).

NODE_ENV=development

# ─── GOOGLE MAPS ───────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─── API BASE URL ──────────────────────────────────────────────────────────────
#
# Leave unset to use automatic detection (recommended for most setups):
#   Android emulator     → http://10.0.2.2:4000/api
#   iOS simulator        → http://127.0.0.1:4000/api
#   Physical device /
#   Expo Go / Dev build  → derived from the Expo dev server LAN IP
#
# Set manually only if auto-detection fails:
#   Find your machine's LAN IP (ipconfig on Windows, ifconfig on Mac/Linux)
#   then uncomment and edit:
#
# EXPO_PUBLIC_API_URL=http://<YOUR_LAN_IP>:4000/api

# ─── PRODUCTION ───────────────────────────────────────────────────────────────
# EXPO_PUBLIC_API_URL=https://api.your-domain.com/api
