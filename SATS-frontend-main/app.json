{
  "expo": {
    "name": "SAT",
    "slug": "sats",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sats.png",
    "scheme": "sats",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/sats.png",
          "imageWidth": 300,
          "tabletImage": "./assets/images/sats.png",
          "tabletImageWidth": 400,
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/sats.png",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "react-native-maps",
      "react-native-nfc-manager"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to scan QR codes for asset tracking.",
        "NSLocationWhenInUseUsageDescription": "This app needs access to location to track asset locations and room coordinates.",
        "NFCReaderUsageDescription": "This app needs access to NFC to scan and write asset and room NFC tags.",
        "NSLocalNetworkUsageDescription": "This app connects to the Smart Asset Tracker backend server on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/sats.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.NFC",
        "android.permission.INTERNET"
      ],
      "intentFilters": [
        {
          "action": "android.nfc.action.NDEF_DISCOVERED",
          "data": [
            {
              "scheme": "sats"
            }
          ],
          "category": [
            "android.intent.category.DEFAULT"
          ]
        }
      ],
      "package": "com.smartassettracker"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sats.png"
    },
    "extra": {
      "router": {},
      "googleMapsApiKey": "AIzaSyAzCIdLeWQ3lA2MZ0X2FxZEL1siC_gJyc0",
      "eas": {
        "projectId": "1e3c01d6-e0a2-40b8-bc41-70339333f669"
      }
    }
  }
}
